# Neovim 0.12.5 for AmigaOS 3.x / 68020 / ixemul 48.2 -- the second target
# (ledger section Q). The 0.4.4 baseline is the plain Makefile; this one
# builds only from vendor012/ into build/v012/, sharing amiga/compat.
#
#   make -f Makefile.v012              m68k libraries (build/v012/m68k/lib*.a)
#   make -f Makefile.v012 host-uvsmoke libuv 1.52 backend on this Mac + smoke test
AMIGA   ?= $(HOME)/opt/amiga
AGCC    ?= $(AMIGA)/bin/m68k-amigaos-gcc
AAR     ?= $(AMIGA)/bin/m68k-amigaos-ar
ACFLAGS ?= -mcrt=ixemul -m68020 -O2 -fno-strict-aliasing -Wall -Wno-unused \
           -Wno-pointer-sign
ALDFLAGS ?= -mcrt=ixemul
HOSTCC  ?= cc
V       = vendor012
B       = build/v012/m68k
H       = build/v012/host

COMPAT_INC  = -Iamiga/compat/include
COMPAT_HDRS = $(wildcard amiga/compat/include/*.h amiga/compat/include/*/*.h)
# libamigacompat is the 0.4.4 Makefile's (one library for both targets)
COMPAT_LIB  = build/m68k/libamigacompat.a

.PHONY: all libs host-uvsmoke checks clean
all: libs
libs: $(B)/libamigawide.a $(B)/libuv.a $(B)/liblua.a $(B)/libluv.a $(B)/liblpeg.a \
      $(B)/libunibilium.a $(B)/libutf8proc.a $(B)/libtree-sitter.a $(B)/parsers

$(COMPAT_LIB): $(wildcard amiga/compat/*.c) $(COMPAT_HDRS)
	$(MAKE) build/m68k/libamigacompat.a

# ---- libuv 1.52.1: the UNIX core, posix-poll, no threads (as 1.30's port) --
UV      = $(V)/libuv
UV_COMMON = fs-poll.c idna.c inet.c random.c strscpy.c strtok.c thread-common.c \
            threadpool.c timer.c uv-common.c uv-data-getter-setters.c version.c
UV_UNIX = async.c core.c dl.c fs.c getaddrinfo.c getnameinfo.c loop-watcher.c \
          loop.c pipe.c poll.c process.c signal.c stream.c tcp.c tty.c udp.c \
          posix-poll.c no-fsevents.c no-proctitle.c nothreads.c amiga.c amiga-os.c \
          random-devurandom.c
UV_SRCS = $(addprefix src/,$(UV_COMMON)) $(addprefix src/unix/,$(UV_UNIX))
UV_INC  = -I$(UV)/include -I$(UV)/src
UV_OBJS = $(addprefix $(B)/libuv/,$(UV_SRCS:.c=.o))
UV_HDRS = $(wildcard $(UV)/include/*.h $(UV)/include/uv/*.h $(UV)/src/*.h \
            $(UV)/src/unix/*.h)

$(B)/libuv/%.o: $(UV)/%.c $(UV_HDRS) $(COMPAT_HDRS)
	@mkdir -p $(dir $@)
	$(AGCC) $(ACFLAGS) $(COMPAT_INC) $(UV_INC) -c -o $@ $<

$(B)/libuv.a: $(UV_OBJS)
	rm -f $@
	$(AAR) rcs $@ $(UV_OBJS)

$(B)/uvsmoke: tests/uvsmoke.c $(B)/libuv.a $(COMPAT_LIB)
	$(AGCC) $(ACFLAGS) $(COMPAT_INC) -I$(UV)/include -c -o $(B)/uvsmoke.o tests/uvsmoke.c
	$(AGCC) $(ALDFLAGS) -o $@ $(B)/uvsmoke.o $(B)/libuv.a $(COMPAT_LIB) -lixcompat

# ---- the same libuv on this Mac (UV_NO_THREADS, UV_POSIX_POLL) -------------
IXCOMPAT ?= $(HOME)/Code/ixemul-vtcon/compat
# UV_STATIC_DL: the static uv_dlopen the Amiga uses (src/unix/dl.c)
HCFLAGS = -O1 -g -Wall -Wno-unused -Wno-deprecated-declarations \
          -DUV_NO_THREADS -DUV_POSIX_POLL -DUV_STATIC_DL -Dpoll=uvhost_select_poll \
          -D_DARWIN_UNLIMITED_SELECT=0 -I$(UV)/include -I$(UV)/src
H_UV_OBJS = $(filter-out $(H)/libuv/src/unix/amiga-os.o,\
              $(addprefix $(H)/libuv/,$(UV_SRCS:.c=.o))) $(H)/libuv/ixpoll.o \
            $(H)/libuv/src/unix/random-getentropy.o

$(H)/libuv/%.o: $(UV)/%.c $(UV_HDRS)
	@mkdir -p $(dir $@)
	$(HOSTCC) $(HCFLAGS) -c -o $@ $<

$(H)/libuv/ixpoll.o: $(IXCOMPAT)/poll.c
	@mkdir -p $(dir $@)
	$(HOSTCC) $(HCFLAGS) -c -o $@ $<

$(H)/libuv.a: $(H_UV_OBJS)
	rm -f $@
	ar rcs $@ $(H_UV_OBJS)

$(H)/uvsmoke: tests/uvsmoke.c $(H)/libuv.a
	$(HOSTCC) $(HCFLAGS) -o $@ tests/uvsmoke.c $(H)/libuv.a

host-uvsmoke: $(H)/uvsmoke
	$(H)/uvsmoke

# checks that need no Amiga: the program path behind $VIMRUNTIME (host,
# dos.library stubbed) and a 64-bit lua_Integer (m68k, compile only)
$(H)/progpath_check: tests/progpath_check.c $(UV)/src/unix/amiga-os.c $(wildcard tests/progpath_stubs/*/*.h)
	@mkdir -p $(H)
	$(HOSTCC) -Wall -Itests/progpath_stubs -I$(UV)/src/unix -o $@ tests/progpath_check.c

checks: $(H)/progpath_check
	$(H)/progpath_check
	$(AGCC) $(ACFLAGS) -I$(LUA) -fsyntax-only tests/luaint_check.c

clean:
	rm -rf build/v012

# libuv's own test runner over the host build (UVT=v012 tools/uv-host-tests.sh)
UV_TEST_SRCS = $(filter-out $(UV)/test/benchmark-% $(UV)/test/runner-win.c \
                 $(UV)/test/run-benchmarks.c $(UV)/test/echo-server.c \
                 $(UV)/test/blackhole-server.c,$(wildcard $(UV)/test/*.c))
$(H)/uv-run-tests: $(UV_TEST_SRCS) $(H)/libuv.a
	$(HOSTCC) $(HCFLAGS) -w -Wno-error=int-conversion -include pthread.h -I$(UV)/test -o $@ $(UV_TEST_SRCS) \
	  $(UV)/test/echo-server.c $(UV)/test/blackhole-server.c $(H)/libuv.a -lpthread

# libamigacompat's AmigaOS parts (atomics, clocks), self-checking on the rig
$(B)/compat_probe: tests/compat_probe.c $(COMPAT_LIB)
	@mkdir -p $(B)
	$(AGCC) $(ACFLAGS) $(COMPAT_INC) -c -o $(B)/compat_probe.o tests/compat_probe.c
	$(AGCC) $(ALDFLAGS) -o $@ $(B)/compat_probe.o $(COMPAT_LIB) -lixcompat

# ---- the other dependencies: one set of rules for m68k and the host --------
# (host: `make -f Makefile.v012 host-deps`, which reruns these with the host
# compiler into build/v012/hostdeps). DCFLAGS carries the target's flags.
DCC     ?= $(AGCC)
DAR     ?= $(AAR)
DCFLAGS ?= $(ACFLAGS) $(COMPAT_INC)

LUA     = vendor/lua/src
LUA_SRCS = lapi.c lcode.c ldebug.c ldo.c ldump.c lfunc.c lgc.c llex.c lmem.c \
           lobject.c lopcodes.c lparser.c lstate.c lstring.c ltable.c ltm.c \
           lundump.c lvm.c lzio.c lauxlib.c lbaselib.c ldblib.c liolib.c \
           lmathlib.c loslib.c ltablib.c lstrlib.c loadlib.c linit.c
LUA_DEFS ?= -DLUA_USE_POSIX

$(B)/lua/%.o: $(LUA)/%.c $(wildcard $(LUA)/*.h)
	@mkdir -p $(dir $@)
	$(DCC) $(DCFLAGS) $(LUA_DEFS) -c -o $@ $<

$(B)/liblua.a: $(addprefix $(B)/lua/,$(LUA_SRCS:.c=.o))
	rm -f $@
	$(DAR) rcs $@ $^

# luv 1.52.1-0 (one translation unit) + lua-compat-5.3 0.13
LUV     = $(V)/luv
LC53    = $(V)/lua-compat-5.3
$(B)/luv/luv.o: $(wildcard $(LUV)/src/*.c $(LUV)/src/*.h) $(UV_HDRS)
	@mkdir -p $(dir $@)
	$(DCC) $(DCFLAGS) -I$(UV)/include -I$(LUA) -I$(LC53)/c-api \
	  -DLUA_COMPAT_APIINTCASTS -c -o $@ $(LUV)/src/luv.c

$(B)/luv/compat-5.3.o: $(LC53)/c-api/compat-5.3.c
	@mkdir -p $(dir $@)
	$(DCC) $(DCFLAGS) -I$(LUA) -I$(LC53)/c-api -c -o $@ $<

$(B)/libluv.a: $(B)/luv/luv.o $(B)/luv/compat-5.3.o
	rm -f $@
	$(DAR) rcs $@ $^

# lpeg 1.1.0 (linked into nvim since 0.10: vim.lpeg)
LPEG    = $(V)/lpeg
LPEG_SRCS = lpcap.c lpcode.c lpcset.c lpprint.c lptree.c lpvm.c
$(B)/lpeg/%.o: $(LPEG)/%.c $(wildcard $(LPEG)/*.h)
	@mkdir -p $(dir $@)
	$(DCC) $(DCFLAGS) -I$(LUA) -c -o $@ $<

$(B)/liblpeg.a: $(addprefix $(B)/lpeg/,$(LPEG_SRCS:.c=.o))
	rm -f $@
	$(DAR) rcs $@ $^

# unibilium 2.1.2 (terminfo dirs as in the 0.4.4 build)
UB      = $(V)/unibilium
UB_DEFS = -DTERMINFO_DIRS='"/usr/share/terminfo:/usr/lib/terminfo:/gg/share/terminfo"'
$(B)/unibilium/%.o: $(UB)/%.c $(UB)/unibilium.h
	@mkdir -p $(dir $@)
	$(DCC) $(DCFLAGS) $(UB_DEFS) -I$(UB) -c -o $@ $<

$(B)/libunibilium.a: $(addprefix $(B)/unibilium/,unibilium.o uninames.o uniutil.o)
	rm -f $@
	$(DAR) rcs $@ $^

# utf8proc 2.11.3 (static: UTF8PROC_STATIC)
U8P     = $(V)/utf8proc
$(B)/utf8proc/utf8proc.o: $(U8P)/utf8proc.c $(U8P)/utf8proc_data.c $(U8P)/utf8proc.h
	@mkdir -p $(dir $@)
	$(DCC) $(DCFLAGS) -DUTF8PROC_STATIC -I$(U8P) -c -o $@ $<

$(B)/libutf8proc.a: $(B)/utf8proc/utf8proc.o
	rm -f $@
	$(DAR) rcs $@ $^

# tree-sitter 0.26.13 (lib.c amalgamation; its atomics are libamigacompat's
# builtins on the Amiga)
TS      = $(V)/tree-sitter/lib
# its portable/endian.h knows no AmigaOS: libamigacompat's <endian.h>
TS_DEFS ?= -DHAVE_ENDIAN_H
$(B)/tree-sitter/lib.o: $(wildcard $(TS)/src/*.c $(TS)/src/*.h $(TS)/include/tree_sitter/*.h)
	@mkdir -p $(dir $@)
	$(DCC) $(DCFLAGS) $(TS_DEFS) -std=gnu99 -I$(TS)/include -I$(TS)/src -c -o $@ $(TS)/src/lib.c

$(B)/libtree-sitter.a: $(B)/tree-sitter/lib.o
	rm -f $@
	$(DAR) rcs $@ $^

# the bundled parsers, one static library each (ledger Q-D4)
PARSERS = c lua vim vimdoc query markdown markdown_inline
P_DIR_c = $(V)/ts-c/src
P_DIR_lua = $(V)/ts-lua/src
P_DIR_vim = $(V)/ts-vim/src
P_DIR_vimdoc = $(V)/ts-vimdoc/src
P_DIR_query = $(V)/ts-query/src
P_DIR_markdown = $(V)/ts-markdown/tree-sitter-markdown/src
P_DIR_markdown_inline = $(V)/ts-markdown/tree-sitter-markdown-inline/src

define parser_rule
$(B)/parser/$(1)/parser.o: $$(P_DIR_$(1))/parser.c
	@mkdir -p $$(dir $$@)
	$$(DCC) $$(DCFLAGS) -std=gnu99 -I$$(P_DIR_$(1)) -c -o $$@ $$<
$(B)/parser/$(1)/scanner.o: $$(P_DIR_$(1))/scanner.c
	@mkdir -p $$(dir $$@)
	$$(DCC) $$(DCFLAGS) -std=gnu99 -I$$(P_DIR_$(1)) -c -o $$@ $$<
$(B)/libtsparser_$(1).a: $(B)/parser/$(1)/parser.o $$(if $$(wildcard $$(P_DIR_$(1))/scanner.c),$(B)/parser/$(1)/scanner.o)
	rm -f $$@
	$$(DAR) rcs $$@ $$^
endef
$(foreach p,$(PARSERS),$(eval $(call parser_rule,$(p))))

$(B)/parsers: $(foreach p,$(PARSERS),$(B)/libtsparser_$(p).a)
	@touch $@

# wide-character classification on utf8proc (amiga/wide; m68k only)
$(B)/wide/wctype.o: amiga/wide/wctype.c $(U8P)/utf8proc.h $(COMPAT_HDRS)
	@mkdir -p $(dir $@)
	$(DCC) $(DCFLAGS) -DUTF8PROC_STATIC -I$(U8P) -c -o $@ $<

$(B)/libamigawide.a: $(B)/wide/wctype.o
	rm -f $@
	$(DAR) rcs $@ $^

# ---- host copies of the dependencies (for the host proof build of 0.12.5) --
HD = build/v012/hostdeps
HD_MAKE = $(MAKE) -f Makefile.v012 B=$(HD) DCC=$(HOSTCC) DAR=ar \
          DCFLAGS='-O1 -g -w -DUV_NO_THREADS -DUV_POSIX_POLL' \
          LUA_DEFS='-DLUA_USE_POSIX -DLUA_USE_DLOPEN' TS_DEFS=
host-deps: $(H)/libuv.a
	mkdir -p $(HD) && cp $(H)/libuv.a $(HD)/libuv.a
	$(HD_MAKE) -o $(HD)/libuv.a $(HD)/liblua.a $(HD)/libluv.a $(HD)/liblpeg.a \
	  $(HD)/libunibilium.a $(HD)/libutf8proc.a $(HD)/libtree-sitter.a $(HD)/parsers

# the host Lua 5.1 that runs Neovim's generators: arm64, like the host-built
# nlua0 module it must load (the host LuaJIT is x86_64)
$(H)/lua51: $(HD)/liblua.a
	$(HOSTCC) -O1 -g -w -DLUA_USE_POSIX -DLUA_USE_DLOPEN -o $@ $(LUA)/lua.c $(HD)/liblua.a \
	  -Wl,-export_dynamic

# ---- sysroot: the dependencies as Neovim 0.12's CMake finds them ----------
SR = $(B)/sysroot
sysroot:
	rm -rf $(SR) && mkdir -p $(SR)/include/luv $(SR)/include/uv $(SR)/include/tree_sitter $(SR)/lib
	cp $(UV)/include/*.h $(SR)/include/ && cp $(UV)/include/uv/*.h $(SR)/include/uv/
	cp $(LUA)/lua.h $(LUA)/luaconf.h $(LUA)/lualib.h $(LUA)/lauxlib.h $(SR)/include/
	cp $(LUV)/src/*.h $(SR)/include/luv/
	cp $(UB)/unibilium.h $(U8P)/utf8proc.h $(SR)/include/
	cp $(TS)/include/tree_sitter/api.h $(SR)/include/tree_sitter/
	cp $(B)/libuv.a $(B)/liblua.a $(B)/libluv.a $(B)/liblpeg.a $(B)/libunibilium.a \
	   $(B)/libutf8proc.a $(B)/libtree-sitter.a $(SR)/lib/
	cp $(B)/libtsparser_*.a $(SR)/lib/
	if [ -f $(B)/libamigawide.a ]; then cp $(B)/libamigawide.a $(SR)/lib/; fi

# ---- dist: what goes onto the Amiga ----------------------------------------
# build/v012/dist/nvim/bin/nvim (stripped) + share/nvim/runtime (from the
# host build's install: generated syntax, help tags), with an empty
# runtime/parser/<lang>.so marker for each linked parser (os/static_dl.c).
# uvsmoke (libuv 1.52) and compat_probe go alongside.
DIST = build/v012/dist/nvim
TS_LINKED ?= vimdoc lua query markdown markdown_inline
dist: checks $(B)/uvsmoke $(B)/compat_probe $(H)/lua51-m68kdump
	ninja -C $(B)/nvim nvim_bin
	ninja -C $(H)/nvim nvim
	rm -rf $(H)/stage && DESTDIR=$(CURDIR)/$(H)/stage ninja -C $(H)/nvim install > $(H)/install.log
	# the host build links the same parsers statically: markers there too
	# (this runtime stays source Lua: the host nvim runs it, tools/user-config.sh)
	mkdir -p $(H)/stage/usr/local/share/nvim/runtime/parser
	for p in $(TS_LINKED); do : > $(H)/stage/usr/local/share/nvim/runtime/parser/$$p.so; done
	rm -rf build/v012/dist && mkdir -p $(DIST)/bin $(DIST)/share/nvim
	$(AMIGA)/bin/m68k-amigaos-strip -o $(DIST)/bin/nvim $(B)/nvim/bin/nvim
	chmod +x $(DIST)/bin/nvim
	cp -R $(H)/stage/usr/local/share/nvim/runtime $(DIST)/share/nvim/
	mkdir -p $(DIST)/share/nvim/runtime/parser
	for p in $(TS_LINKED); do : > $(DIST)/share/nvim/runtime/parser/$$p.so; done
	# FFS (OFS/FFS without long names) holds 30 characters per name: the one
	# runtime file over that, a keymap, is left out (ledger section Q)
	rm -f $(DIST)/share/nvim/runtime/keymap/brazilian_portuguese-compact.vim
	! find $(DIST) -exec basename {} \; | awk 'length($$0)>30' | grep .
	# runtime/lua as m68k bytecode, same file names (ledger Q13)
	$(H)/lua51-m68kdump tools/precompile-lua.lua $$(find $(DIST)/share/nvim/runtime/lua -name '*.lua')
	cp $(B)/uvsmoke $(B)/compat_probe build/v012/dist/
	ls -l $(DIST)/bin/nvim

# ---- the host Lua that dumps bytecode for the Amiga (ledger Q13) ----------
# vendor/lua with amiga/lua-m68kdump/{ldump,lundump}.c: string.dump writes
# (and load reads) the m68k format. Same C ABI as $(H)/lua51, so it can run
# Neovim's generators and load the host nlua0 too.
LUA_HOST_SRCS = $(filter-out ldump.c lundump.c,$(LUA_SRCS))
$(H)/lua51-m68kdump: $(addprefix $(LUA)/,$(LUA_HOST_SRCS)) $(LUA)/lua.c \
                     amiga/lua-m68kdump/ldump.c amiga/lua-m68kdump/lundump.c
	@mkdir -p $(H)
	$(HOSTCC) -O1 -g -w -DLUA_USE_POSIX -DLUA_USE_DLOPEN -I$(LUA) -o $@ \
	  $(addprefix $(LUA)/,$(LUA_HOST_SRCS)) amiga/lua-m68kdump/ldump.c \
	  amiga/lua-m68kdump/lundump.c $(LUA)/lua.c -Wl,-export_dynamic
